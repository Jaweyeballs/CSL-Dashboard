PORT=3000

# Spotify Developer App (https://developer.spotify.com/dashboard)
# Redirect URI must be exactly: http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Public ICS calendar URL (Google Calendar → Settings → Integrate calendar → Secret address in iCal format)
# Leave blank to use built-in demo events
CALENDAR_ICS_URL=

# How often to refresh calendar cache (minutes)
CALENDAR_POLL_MINUTES=10

# Optional simple password for the /admin Jam link page (leave blank for open local use)
ADMIN_PASSWORD=

# Keywords that mark lounge socials (comma-separated, case-insensitive)
LOUNGE_KEYWORDS=csl,coding & social,coding and social,lounge social,lounge night
